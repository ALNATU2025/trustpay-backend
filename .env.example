# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000

# MongoDB Atlas (or local): mongodb+srv://USER:PASSWORD@cluster.mongodb.net/trustpay?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/trustpay

# 32+ random characters:  openssl rand -hex 32
JWT_SECRET=
# Exactly 64 hex characters:  openssl rand -hex 32
CARD_ENCRYPTION_KEY=
# 16+ random characters. Partners sign webhooks with this (HMAC-SHA256 of the raw body, header x-signature).
WEBHOOK_SECRET=

# sandbox = fake banks/SMS/vendors (safe). live = real partners (adapters in src/providers must be implemented).
PROVIDER_MODE=sandbox
# Returns the SMS code in the API response so you can test without an SMS gateway. NEVER true in production.
OTP_DEBUG=true

CORS_ORIGINS=*
BCRYPT_COST=12
MAX_AMOUNT_LE=1000000
SETTLEMENT_FEE_BPS=40

# First admin (used by `npm run seed`). Remove ADMIN_PASSWORD after the first run.
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=TrustPay
ADMIN_LAST_NAME=Admin
