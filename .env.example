# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000

# MongoDB Atlas (or local): mongodb+srv://USER:PASSWORD@cluster.mongodb.net/trustpay?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://trustpayssupport_db_user@trustpay-cluster.h2fcdzr.mongodb.net/trustpay?retryWrites=true&w=majority
MONGODB_USERNAME=trustpayssupport_db_user
# 32+ random characters:  openssl rand -hex 32
JWT_SECRET=cdcd4efdd96ece17000e4a06538ae519b86dcdb803e95cd945a012dae98304b1abe6a4d6ef3fc650d2d56939ac7e942c5b38a2045b4d34de2ddff9235a7e4905
# Exactly 64 hex characters:  openssl rand -hex 32
CARD_ENCRYPTION_KEY=
# 16+ random characters. Partners sign webhooks with this (HMAC-SHA256 of the raw body, header x-signature).
MONIME_WEBHOOK_SECRET=

# sandbox = fake banks/SMS/vendors (safe). live = real partners (adapters in src/providers must be implemented).
PROVIDER_MODE=live
# Returns the SMS code in the API response so you can test without an SMS gateway. NEVER true in production.
OTP_DEBUG=true
# Only needed when NODE_ENV=production AND PROVIDER_MODE=sandbox (a public test deployment with fake money).
ALLOW_SANDBOX_IN_PRODUCTION=false
# true = new customers wait for an admin to approve their identity (Admin > Approvals) before they can pay.
KYC_MANUAL=false

CORS_ORIGINS=*
BCRYPT_COST=12
MAX_AMOUNT_LE=1000000
SETTLEMENT_FEE_BPS=40

# First admin (used by `npm run seed`). Remove ADMIN_PASSWORD after the first run.
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=TrustPay
ADMIN_LAST_NAME=Admin

# ---- Monime (live mode: banks, mobile money, card top-ups). See MONIME.md ----
MONIME_ACCESS_TOKEN=
MONIME_SPACE_ID=
# 32-256 random characters, also entered as the HS256 secret when registering the webhook
MONIME_WEBHOOK_SECRET=
# Public URL of this API, e.g. https://trustpay-backend-zkiv.onrender.com
PUBLIC_URL=https://trustpay-backend-zkiv.onrender.com
# Comma-separated user _ids that always have full admin access (super admin).
SUPER_ADMIN_IDS=6ad0e47586522f7476ca3775
# MONIME_PAYOUT_ACCOUNT_ID=
# MONIME_FUNDING_ACCOUNT_ID=   # optional: financial account (fac-...) that receives top-ups; empty = main account
# MONIME_COUNTRY=SL
